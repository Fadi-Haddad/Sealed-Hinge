H DX=400 DY=200 DZ=45 -AB C=0 T=458852 R=1 *MM /"def" V=11
F =4
;----------------------------------------------------------------------
L TOOL_DIAMETER =8
L HINGE_LEN =165
L HINGE_WIDTH =31
L DEPTH_ARC =9
L OFFSET_X =82.5
L OFFSET_Y =15.5
L PASS =9
L DEPTH_RECT =9
L DEPTH_RECT2 =28
L STEP_OVER =8
L STEP_OVER_A =2
;----------------------------------------------------------------------
; RECTANGLE DIMENSIONS
L OUTER_RECT_LENGTH =150
L OUTER_RECT_WIDTH =HINGE_WIDTH  ; 31mm
L OUTER_RECT_DEPTH =DEPTH_RECT   ; 9mm

L INNER_RECT_LENGTH =107  
L INNER_RECT_WIDTH =HINGE_WIDTH  ; 31mm
L INNER_RECT_DEPTH =DEPTH_RECT2  ; 28mm

; CALCULATED PARAMETERS
L TOOL_RADIUS =TOOL_DIAMETER/2

; CENTER DATUM CALCULATIONS
L OUTER_START_X =OFFSET_X - OUTER_RECT_LENGTH/2
L OUTER_START_Y =OFFSET_Y - OUTER_RECT_WIDTH/2
L OUTER_END_X =OFFSET_X + OUTER_RECT_LENGTH/2
L OUTER_END_Y =OFFSET_Y + OUTER_RECT_WIDTH/2

L INNER_START_X =OFFSET_X - INNER_RECT_LENGTH/2
L INNER_START_Y =OFFSET_Y - INNER_RECT_WIDTH/2
L INNER_END_X =OFFSET_X + INNER_RECT_LENGTH/2
L INNER_END_Y =OFFSET_Y + INNER_RECT_WIDTH/2

;============= OUTER RECTANGLE =============
L ZR =0
. label_outer_depth
L ZR =ZR + PASS
IF ZR > OUTER_RECT_DEPTH THEN
   L ZR =OUTER_RECT_DEPTH
FI

; Undersized zigzag pocketing
L Y_CURRENT =OUTER_START_Y + TOOL_RADIUS
G0 X=OUTER_START_X + TOOL_RADIUS Y=Y_CURRENT Z=-ZR T=106
G1 Z=-ZR

. label_outer_zigzag
G1 X=OUTER_END_X - TOOL_RADIUS Y=Y_CURRENT Z=-ZR
L Y_CURRENT =Y_CURRENT + STEP_OVER
IF Y_CURRENT > OUTER_END_Y - TOOL_RADIUS THEN
   G1 X=OUTER_END_X - TOOL_RADIUS Y=OUTER_END_Y - TOOL_RADIUS Z=-ZR
   G1 X=OUTER_START_X + TOOL_RADIUS Y=OUTER_END_Y - TOOL_RADIUS Z=-ZR
   GOTO next_outer_depth
FI

G1 X=OUTER_END_X - TOOL_RADIUS Y=Y_CURRENT Z=-ZR
G1 X=OUTER_START_X + TOOL_RADIUS Y=Y_CURRENT Z=-ZR
L Y_CURRENT =Y_CURRENT + STEP_OVER
IF Y_CURRENT > OUTER_END_Y - TOOL_RADIUS THEN
   G1 X=OUTER_START_X + TOOL_RADIUS Y=OUTER_END_Y - TOOL_RADIUS Z=-ZR
   G1 X=OUTER_END_X - TOOL_RADIUS Y=OUTER_END_Y - TOOL_RADIUS Z=-ZR
   GOTO next_outer_depth
FI

G1 X=OUTER_START_X + TOOL_RADIUS Y=Y_CURRENT Z=-ZR
GOTO label_outer_zigzag

. next_outer_depth
IF ZR >= OUTER_RECT_DEPTH GOTO outer_perimeter_cleanup
GOTO label_outer_depth

. outer_perimeter_cleanup
L ZR =0
. label_outer_perimeter_depth
L ZR =ZR + PASS
IF ZR > OUTER_RECT_DEPTH THEN
   L ZR =OUTER_RECT_DEPTH
FI

G0 X=OUTER_START_X + TOOL_RADIUS Y=OUTER_START_Y + TOOL_RADIUS Z=-ZR T=106
G1 Z=-ZR
G1 X=OUTER_END_X - TOOL_RADIUS Y=OUTER_START_Y + TOOL_RADIUS Z=-ZR
G1 X=OUTER_END_X - TOOL_RADIUS Y=OUTER_END_Y - TOOL_RADIUS Z=-ZR
G1 X=OUTER_START_X + TOOL_RADIUS Y=OUTER_END_Y - TOOL_RADIUS Z=-ZR
G1 X=OUTER_START_X + TOOL_RADIUS Y=OUTER_START_Y + TOOL_RADIUS Z=-ZR

. next_outer_perimeter_depth
IF ZR >= OUTER_RECT_DEPTH GOTO done_outer
GOTO label_outer_perimeter_depth
. done_outer

;============= INNER RECTANGLE =============
L ZR =0
. label_inner_depth
L ZR =ZR + PASS
IF ZR > INNER_RECT_DEPTH THEN
   L ZR =INNER_RECT_DEPTH
FI

; Undersized zigzag pocketing
L Y_CURRENT =INNER_START_Y + TOOL_RADIUS
G0 X=INNER_START_X + TOOL_RADIUS Y=Y_CURRENT Z=-ZR T=106
G1 Z=-ZR

. label_inner_zigzag
G1 X=INNER_END_X - TOOL_RADIUS Y=Y_CURRENT Z=-ZR
L Y_CURRENT =Y_CURRENT + STEP_OVER
IF Y_CURRENT > INNER_END_Y - TOOL_RADIUS THEN
   G1 X=INNER_END_X - TOOL_RADIUS Y=INNER_END_Y - TOOL_RADIUS Z=-ZR
   G1 X=INNER_START_X + TOOL_RADIUS Y=INNER_END_Y - TOOL_RADIUS Z=-ZR
   GOTO next_inner_depth
FI

G1 X=INNER_END_X - TOOL_RADIUS Y=Y_CURRENT Z=-ZR
G1 X=INNER_START_X + TOOL_RADIUS Y=Y_CURRENT Z=-ZR
L Y_CURRENT =Y_CURRENT + STEP_OVER
IF Y_CURRENT > INNER_END_Y - TOOL_RADIUS THEN
   G1 X=INNER_START_X + TOOL_RADIUS Y=INNER_END_Y - TOOL_RADIUS Z=-ZR
   G1 X=INNER_END_X - TOOL_RADIUS Y=INNER_END_Y - TOOL_RADIUS Z=-ZR
   GOTO next_inner_depth
FI

G1 X=INNER_START_X + TOOL_RADIUS Y=Y_CURRENT Z=-ZR
GOTO label_inner_zigzag

. next_inner_depth
IF ZR >= INNER_RECT_DEPTH GOTO inner_perimeter_cleanup
GOTO label_inner_depth

. inner_perimeter_cleanup
L ZR =0
. label_inner_perimeter_depth
L ZR =ZR + PASS
IF ZR > INNER_RECT_DEPTH THEN
   L ZR =INNER_RECT_DEPTH
FI

G0 X=INNER_START_X + TOOL_RADIUS Y=INNER_START_Y + TOOL_RADIUS Z=-ZR T=106
G1 Z=-ZR
G1 X=INNER_END_X - TOOL_RADIUS Y=INNER_START_Y + TOOL_RADIUS Z=-ZR
G1 X=INNER_END_X - TOOL_RADIUS Y=INNER_END_Y - TOOL_RADIUS Z=-ZR
G1 X=INNER_START_X + TOOL_RADIUS Y=INNER_END_Y - TOOL_RADIUS Z=-ZR
G1 X=INNER_START_X + TOOL_RADIUS Y=INNER_START_Y + TOOL_RADIUS Z=-ZR

. next_inner_perimeter_depth
IF ZR >= INNER_RECT_DEPTH GOTO done_inner
GOTO label_inner_perimeter_depth
. done_inner

;============= LEFT ARC POCKETING =============
L ZA =0
. label_left_arc_depth
L ZA =ZA + PASS
IF ZA > DEPTH_ARC THEN
   L ZA = DEPTH_ARC
FI

L OFFSET=0
. label_left_offset
IF OFFSET >= HINGE_WIDTH/2 GOTO next_left_depth

; Arc positioning: Y starts at TOP, goes to bottom  
G0 X=OFFSET_X - OUTER_RECT_LENGTH/2 + TOOL_RADIUS + OFFSET Y=OFFSET_Y + HINGE_WIDTH/2 - TOOL_RADIUS Z=0 T=106
G1 Z=-ZA
; G3 from top to bottom of arc (flipped direction)
G3 X=OFFSET_X - OUTER_RECT_LENGTH/2 + TOOL_RADIUS + OFFSET Y=OFFSET_Y - HINGE_WIDTH/2 + TOOL_RADIUS Z=-ZA r=HINGE_WIDTH/2

L OFFSET = OFFSET + STEP_OVER_A
GOTO label_left_offset

. next_left_depth
IF ZA >= DEPTH_ARC GOTO done_left_arc
GOTO label_left_arc_depth
. done_left_arc

;============= RIGHT ARC POCKETING =============
L ZA =0
. label_right_arc_depth
L ZA =ZA + PASS
IF ZA > DEPTH_ARC THEN
   L ZA = DEPTH_ARC
FI

L OFFSET=0
. label_right_offset
IF OFFSET >= HINGE_WIDTH/2 GOTO next_right_depth

; Arc positioning: X = datum + 75 - 4 = +71, Y starts at bottom  
G0 X=OFFSET_X + OUTER_RECT_LENGTH/2 - TOOL_RADIUS - OFFSET Y=OFFSET_Y - HINGE_WIDTH/2 + TOOL_RADIUS Z=0 T=106
G1 Z=-ZA
; G3 from bottom to top of arc
G3 X=OFFSET_X + OUTER_RECT_LENGTH/2 - TOOL_RADIUS - OFFSET Y=OFFSET_Y + HINGE_WIDTH/2 - TOOL_RADIUS Z=-ZA r=HINGE_WIDTH/2

L OFFSET = OFFSET + STEP_OVER_A  
GOTO label_right_offset

. next_right_depth
IF ZA >= DEPTH_ARC GOTO done_right_arc
GOTO label_right_arc_depth
. done_right_arc

N X=0 Y=0 V=20